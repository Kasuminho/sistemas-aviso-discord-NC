# Token do Bot do Discord (Obtido no Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=seu_token_aqui

# ID da Aplicação / Bot (Obtido no Discord Developer Portal > General Information > Application ID)
CLIENT_ID=seu_client_id_aqui

# ID do Servidor Discord (Guild ID)
GUILD_ID=seu_guild_id_aqui

# ID do Cargo da Staff com permissão para usar os comandos administrativos
STAFF_ROLE_ID=1526370359652122826

# ID do Cargo dos Jogadores NC (Permissão para comandos de Alt Timers)
EVENT_ROLE_ID=1525526128725459065

# ID do Canal exclusivo onde os comandos de Alt Timer podem ser executados
ALT_TIMER_CHANNEL_ID=1527700863345229834

# ID do Canal onde os avisos de eventos serão enviados por padrão
ANNOUNCEMENT_CHANNEL_ID=seu_id_do_canal_aqui

# ID da Categoria de Canais de Voz para monitorar Mute de 10 minutos
VOICE_CATEGORY_ID=1525526402500395189

# ID do Canal AFK (Opcional. Se omitido, usará o canal AFK configurado no servidor Discord)
AFK_CHANNEL_ID=

# Chave da API do Google Gemini (Obtida gratuitamente em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# ID do Administrador permitido no Painel Web
ALLOWED_USER_ID=1526370359652122826

# Chave / Senha Mestra de Login no Painel Web
ADMIN_KEY=raven123
